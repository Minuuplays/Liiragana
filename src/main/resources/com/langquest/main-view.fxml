<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.langquest.MainController"
            fx:id="rootPane"
            prefWidth="650" prefHeight="450">
    <left>
        <VBox spacing="12" alignment="TOP_CENTER"
              style="-fx-padding: 20; -fx-background-color: #e8e8e8; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <Button text="Lessons" onAction="#showLessons" maxWidth="Infinity"/>
            <Button text="Vocabulary" onAction="#showVocabulary" maxWidth="Infinity"/>
            <Button text="Profile" onAction="#showProfile" maxWidth="Infinity"/>
        </VBox>
    </left>
</BorderPane>