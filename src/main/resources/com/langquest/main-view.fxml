<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.langquest.MainController"
           prefWidth="650" prefHeight="450">

    <SplitPane dividerPositions="0.25">
        <VBox spacing="8" alignment="TOP_CENTER" minWidth="120" maxWidth="300"
              styleClass="sidebar" style="-fx-padding: 20;">
            <Button fx:id="lessonsButton" text="Lessons" onAction="#showLessons" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="vocabularyButton" text="Vocabulary" onAction="#showVocabulary" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="profileButton" text="Profile" onAction="#showProfile" maxWidth="Infinity" styleClass="nav-button"/>
            <Button fx:id="leaderboardButton" text="Leaderboard" onAction="#showLeaderboard" maxWidth="Infinity" styleClass="nav-button"/>
        </VBox>

        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </SplitPane>

    <VBox fx:id="toastLayer" StackPane.alignment="BOTTOM_RIGHT" alignment="TOP_RIGHT" mouseTransparent="true" spacing="8"
          style="-fx-padding: 20 20 30 0;"/>

</StackPane>