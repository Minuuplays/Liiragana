<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.langquest.MainController"
            fx:id="rootPane"
            prefWidth="550" prefHeight="400">
    <left>
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #e8e8e8;">
            <Button text="Lessons" onAction="#showLessons" prefWidth="120"/>
            <Button text="Vocabulary" onAction="#showVocabulary" prefWidth="120"/>
            <Button text="Profile" onAction="#showProfile" prefWidth="120"/>
        </VBox>
    </left>
</BorderPane>