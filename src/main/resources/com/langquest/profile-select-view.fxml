<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.langquest.ProfileSelectController"
            style="-fx-padding: 30;">
    <top>
        <Label text="Who's learning?" styleClass="screen-title"
               style="-fx-padding: 0 0 20 0;" BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="25">
            <ScrollPane fitToWidth="true" maxWidth="300" prefHeight="180">
                <VBox fx:id="userButtonsBox" spacing="8" alignment="TOP_CENTER" style="-fx-padding: 10;"/>
            </ScrollPane>
            <GridPane hgap="10" vgap="12" alignment="CENTER">
                <Label text="New username:" styleClass="form-label"
                       GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="newUsernameField"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button text="Create Profile" onAction="#handleCreateProfile" styleClass="primary-button"
                        GridPane.columnIndex="0" GridPane.rowIndex="1"
                        GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
            </GridPane>
        </VBox>
    </center>
</BorderPane>