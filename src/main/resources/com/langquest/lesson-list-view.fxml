<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.langquest.LessonListController"
      spacing="15" style="-fx-padding: 20;">

    <Label text="Choose a Lesson" style="-fx-font-size: 18px;"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-border-color: #dddddd; -fx-border-radius: 4;">
        <VBox fx:id="lessonButtonsBox" spacing="8" style="-fx-padding: 10;"/>
    </ScrollPane>

</VBox>