<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.langquest.ProfileController"
      spacing="20" style="-fx-padding: 20;">

    <Label fx:id="greetingLabel" styleClass="screen-title"/>

    <HBox spacing="15">
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Total XP" styleClass="stat-label"/>
            <Label fx:id="xpValueLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Lessons Completed" styleClass="stat-label"/>
            <Label fx:id="lessonsValueLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Words Learned" styleClass="stat-label"/>
            <Label fx:id="wordsValueLabel" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <HBox spacing="15">
        <VBox styleClass="stat-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Hiragana Mastery" styleClass="stat-label"/>
            <Label fx:id="hiraganaValueLabel" styleClass="stat-value-small"/>
            <ProgressBar fx:id="hiraganaProgressBar" progress="0" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="stat-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Vocabulary Mastery" styleClass="stat-label"/>
            <Label fx:id="vocabValueLabel" styleClass="stat-value-small"/>
            <ProgressBar fx:id="vocabProgressBar" progress="0" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <HBox spacing="15">
        <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Continue Learning" styleClass="stat-label"/>
            <Label fx:id="continueLessonTitleLabel" styleClass="stat-value-small" wrapText="true"/>
            <Button fx:id="continueLessonButton" text="Start" onAction="#handleContinueLearning" styleClass="primary-button"/>
        </VBox>
        <VBox alignment="BOTTOM_RIGHT" HBox.hgrow="ALWAYS">
            <Button text="Lesson History"  onAction="#handleViewHistory" styleClass="option-button"/>
        </VBox>

    </HBox>


    <HBox spacing="10">
        <VBox styleClass="stat-card" alignment="CENTER" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Overall Progress" styleClass="stat-label"/>
            <PieChart fx:id="masteryChart" legendVisible="true" labelsVisible="false" prefHeight="200" maxHeight="200"/>
        </VBox>
        <VBox styleClass="stat-card" spacing="10" HBox.hgrow="ALWAYS">
            <Label text="Achievements" styleClass="stat-label"/>
            <Label fx:id="gettingStartedBadge" text="🌱  Getting Started" styleClass="badge-locked"/>
            <Label fx:id="hiraganaMasterBadge" text="🈴  Hiragana Master" styleClass="badge-locked"/>
            <Label fx:id="vocabMasterBadge" text="📖  Vocabulary Master" styleClass="badge-locked"/>
            <Label fx:id="perfectionistBadge" text="💯  Perfectionist" styleClass="badge-locked"/>
        </VBox>
    </HBox>

    <HBox spacing="15" >
        <VBox alignment="TOP_LEFT" HBox.hgrow="ALWAYS">
        <Button text="Log Out" onAction="#handleLogout" styleClass="logout-button"/>
        </VBox>
        <VBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
        <Button text="Delete Profile" onAction="#handleDeleteProfile" styleClass="danger-button"/>
        </VBox>
    </HBox>

    <Region VBox.vgrow="ALWAYS"/>

</VBox>