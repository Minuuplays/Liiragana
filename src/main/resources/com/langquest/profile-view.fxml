<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.langquest.ProfileController"
      spacing="20" style="-fx-padding: 20;">

    <Label fx:id="greetingLabel" styleClass="screen-title"/>

    <HBox spacing="15">
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Total XP" styleClass="stat-label"/>
            <Label fx:id="xpValueLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Lessons Completed" styleClass="stat-label"/>
            <Label fx:id="lessonsValueLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-card" alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Words Learned" styleClass="stat-label"/>
            <Label fx:id="wordsValueLabel" styleClass="stat-value"/>
        </VBox>
    </HBox>

    <HBox spacing="15">
        <VBox styleClass="stat-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Hiragana Mastery" styleClass="stat-label"/>
            <Label fx:id="hiraganaValueLabel" styleClass="stat-value-small"/>
            <ProgressBar fx:id="hiraganaProgressBar" progress="0" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="stat-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Vocabulary Mastery" styleClass="stat-label"/>
            <Label fx:id="vocabValueLabel" styleClass="stat-value-small"/>
            <ProgressBar fx:id="vocabProgressBar" progress="0" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <Button text="Lesson History" onAction="#handleViewHistory" styleClass="option-button"/>

    <Region VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Delete Profile" onAction="#handleDeleteProfile" styleClass="danger-button"/>
    </HBox>

</VBox>